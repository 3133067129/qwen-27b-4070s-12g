# ============================================================================
#  Bonsai 2 27B (ternary) on NInfer - OpenAI-compatible local endpoint
# ============================================================================
#  1) start the engine and wait until it is ready:
#         D:\projects\qwen3.8_fast\models\start_bonsai_agent.cmd
#     (first load takes ~85 s, the script blocks until /v1/models answers)
#
#  2) export this file into your tool's environment, e.g.
#         set -a; . .env; set +a                    # bash / git-bash / wsl
#         Get-Content .env | % { $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k,$v) }
#     or paste the values into the tool's settings UI.
#
#  Verified against this server: streaming SSE ✔   tool/function calling ✔
#  Anthropic /v1/messages ✔   Authorization header tolerated ✔
# ============================================================================

# --- Generic OpenAI SDK / most gateways: the base URL INCLUDES /v1 ----------
OPENAI_API_KEY=sk-local
OPENAI_BASE_URL=http://127.0.0.1:8099/v1
OPENAI_API_BASE=http://127.0.0.1:8099/v1
OPENAI_API_BASE_URL=http://127.0.0.1:8099/v1
OPENAI_MODEL=qwen3.8-27b

# Some old clients append /v1 themselves - in that case use this instead:
# OPENAI_BASE_URL=http://127.0.0.1:8099

# The served model id must match EXACTLY. Tools that hardcode a name (gpt-4o,
# gpt-4-turbo, ...) work when the engine is started with a renamed identity:
#     ninfer-serve.exe <artifact> --model-id gpt-4o ...
# (see MODEL_ID at the top of start_bonsai_agent.cmd; only one id is served,
#  renaming makes the real name 404 - so the .env must agree with the script.)

# --- Timeouts: only needed when you query before loading finished ------------
OPENAI_TIMEOUT=600
OPENAI_REQUEST_TIMEOUT=600
REQUEST_TIMEOUT=600
HTTP_TIMEOUT=600
LLM_REQUEST_TIMEOUT=600

# --- Generation limits: engine runs with --max-context 8192 ----------------
OPENAI_MAX_TOKENS=2048
MAX_TOKENS=2048
OPENAI_TEMPERATURE=0

# --- Anthropic-style clients: the same server also speaks /v1/messages -----
# (Claude Code and anything that wants ANTHROPIC_BASE_URL)
ANTHROPIC_BASE_URL=http://127.0.0.1:8099
ANTHROPIC_AUTH_TOKEN=sk-local
ANTHROPIC_API_KEY=sk-local
ANTHROPIC_MODEL=qwen3.8-27b
ANTHROPIC_SMALL_FAST_MODEL=qwen3.8-27b
ANTHROPIC_DEFAULT_HAIKU_MODEL=qwen3.8-27b
ANTHROPIC_DEFAULT_SONNET_MODEL=qwen3.8-27b

# --- Aider (reads OPENAI_API_BASE above) -----------------------------------
AIDER_MODEL=openai/qwen3.8-27b
AIDER_WEAK_MODEL=openai/qwen3.8-27b
AIDER_EDIT_FORMAT=whole

# --- LiteLLM proxy / Open WebUI --------------------------------------------
LITELLM_MODEL=openai/qwen3.8-27b
OPENAI_API_KEY_HEADER=Authorization

# --- Notes ------------------------------------------------------------------
# * The engine is started with --no-thinking: answers are direct (6-7x fewer
#   tokens and measurably more accurate on the local 20-task coding suite).
#   If you want the reasoning trace back, remove --no-thinking from the script
#   and raise MAX_TOKENS, the model will then spend thousands of tokens thinking.
# * One request at a time (--max-concurrency 1) on a 12 GB card; long agent
#   loops are prefill-bound. Do not run a second model (Ollama/LM Studio) at
#   the same time - there is only ~1 GiB of VRAM left for runtime.
